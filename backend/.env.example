# SetuSeva - Environment Configuration
# Keep everything simple for students and local development!

SECRET_KEY=mbmc_setuseva_super_secret_key_engineering_project_2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================================================
# DATABASE CONFIGURATION
# Default: SQLite (no setup needed, ready out-of-the-box!)
# To switch to PostgreSQL: change DB_ENGINE to "postgresql" and set credentials.
# ==============================================================================
DB_ENGINE=sqlite

# If DB_ENGINE=postgresql, configure these:
DB_NAME=setuseva_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
